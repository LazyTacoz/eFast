<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Efast">

        <!-- Google Maps API key (set MAPS_API_KEY in local.properties) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.OtpActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.HomeActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.SearchActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.FareQuoteActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.FindingDriverActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.DriverAssignedActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.LiveTripActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.TripCompleteActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Driver side (demo): Home Ride -->
        <activity
            android:name=".ui.DriverHomeRideActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.DriverHomeAddressActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.HomeRideActiveActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>

